        </ul>
    </div>

    <script>
        // üõ†Ô∏è YOUR JAVASCRIPT MISSION:
        
        // 1. Select the textarea (#comment-input), the button (#post-btn), and the list (#comment-list).
        
        // 2. Add a click event listener to the button.
        
