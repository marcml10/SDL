### Project 8: Dynamic Sorting & Pagination Template

```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project 8: Dynamic Sorting & Pagination Engine</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 0; padding: 40px; background: #f8fafc; color: #0f172a; }
        .layout { display: flex; gap: 30px; max-width: 1000px; margin: 0 auto; }
        .filter-panel { background: #fff; padding: 20px; border-radius: 12px; width: 260px; display: flex; flex-direction: column; gap: 20px; }
        .products-panel { flex: 1; }
        .controls-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; min-height: 300px; }
        .product-card { background: white; padding: 16px; border-radius: 10px; border: 1px solid #e2e8f0; }
        
        /* PAGINATION STYLES */
        .pagination-container { display: flex; gap: 8px; justify-content: center; margin-top: 24px; }
        .page-btn { padding: 8px 12px; border: 1px solid #cbd5e1; background: white; border-radius: 6px; cursor: pointer; }
        .page-btn.active { background: #0284c7; color: white; border-color: #0284c7; }
    </style>
</head>
<body>

    <div class="layout">
        <!-- FILTER PANEL -->
        <div class="filter-panel">
            <h3>Search</h3>
            <input type="text" id="search-input" placeholder="Search products...">

            <h3>Max Price: <span id="price-val">$200</span></h3>
            <input type="range" id="price-range" min="10" max="200" value="200">
        </div>

        <!-- PRODUCTS DISPLAY AREA -->
        <div class="products-panel">
            <div class="controls-header">
                <h2>Products</h2>
                
                <!-- SORT DROPDOWN -->
                <div>
                    <label for="sort-select">Sort By:</label>
                    <select id="sort-select">
                        <option value="default">Default</option>
                        <option value="lowToHigh">Price: Low to High</option>
                        <option value="highToLow">Price: High to Low</option>
                        <option value="aToZ">Name: A to Z</option>
                        <option value="zToA">Name: Z to A</option>
                    </select>
                </div>
            </div>

            <div id="product-grid" class="product-grid"></div>

            <!-- PAGINATION CONTROLS -->
            <div id="pagination-container" class="pagination-container">
                <!-- Page buttons will be dynamically rendered here! -->
            </div>
        </div>
    </div>

    <script>
        const catalog = [
            { id: 1, name: "Wireless Earbuds", category: "Electronics", price: 49.99 },
            { id: 2, name: "Mechanical Keyboard", category: "Electronics", price: 89.99 },
            { id: 3, name: "Leather Journal", category: "Accessories", price: 19.99 },
            { id: 4, name: "Water Bottle", category: "Fitness", price: 14.99 },
            { id: 5, name: "Yoga Mat", category: "Fitness", price: 29.99 },
            { id: 6, name: "Smart Watch", category: "Electronics", price: 149.99 },
            { id: 7, name: "Sunglasses", category: "Accessories", price: 39.99 },
            { id: 8, name: "Gaming Mouse", category: "Electronics", price: 59.99 }
        ];

        // 1. EXTENDED STATE OBJECT
        const filterState = {
            searchTerm: "",
            maxPrice: 200,
            sortBy: "default",  // "lowToHigh", "highToLow", "aToZ", "zToA"
            currentPage: 1,
            pageSize: 3         // Show 3 products per page
        };

        // DOM ELEMENTS
        const productGrid = document.getElementById("product-grid");
        const sortSelect = document.getElementById("sort-select");

        // 2. RENDER PRODUCTS FUNCTION
        const renderProducts = (items) => {
            productGrid.innerHTML = "";
            items.forEach((item) => {
                const card = document.createElement("div");
                card.classList.add("product-card");
                card.innerHTML = `
                    <h4>${item.name}</h4>
                    <p>${item.category}</p>
                    <p><strong>$${item.price}</strong></p>
                `;
                productGrid.appendChild(card);
            });
        };

        // YOUR MISSION: BUILD THE ENGINE HERE
        const processPipeline = () => {
            // Step 1: Filter catalog based on filterState
            // Step 2: Sort the filtered results (make sure to copy with [...array]!)
            // Step 3: Calculate startIndex & endIndex using currentPage & pageSize, then .slice()
            // Step 4: Pass sliced items to renderProducts()
        };

    </script>
</body>
</html>
```

