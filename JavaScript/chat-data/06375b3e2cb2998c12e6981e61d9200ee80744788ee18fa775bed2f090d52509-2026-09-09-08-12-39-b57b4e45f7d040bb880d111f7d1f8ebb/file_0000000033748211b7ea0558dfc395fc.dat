    <script>
        // Target your elements
        const taskInput = document.querySelector("#task-input");
        const addBtn = document.querySelector("#add-btn");
        const taskList = document.querySelector("#task-list");

        addBtn.addEventListener("click", () => {
            const inputValue = taskInput.value;
            if (inputValue === "") return; // Don't add empty tasks!

            // 1. Create the li item and add class "list-style"
            
            // 2. Use .innerHTML to inject: `<span>üìå ${inputValue}</span> <button class="delete-btn">Delete</button>`
            
            // 3. Select the delete button inside this specific row using rowElement.querySelector(".delete-btn")
            
            // 4. Add a click event listener to that delete button that calls rowElement.remove()
            
            // 5. Append the whole row to the taskList container
            
            // Clear input field at the end
            taskInput.value = "";
        });
    </script>
</body>
</html>
