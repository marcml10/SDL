        addTaskBtn.addEventListener("click", function() {
            let taskText = taskInput.value;
            if (taskText === "") return;

            // 1. Push a plain string task text into the operationalTasks array
            
            // 2. Clear the input field text
            
            // 3. Save the ENTIRE array to storage using JSON.stringify!
            // Hint: localStorage.setItem("matrixStorage", JSON.stringify(operationalTasks));
            
            // 4. Run your rendering engine (We will create this together next!)
        });
    </script>
</body>
