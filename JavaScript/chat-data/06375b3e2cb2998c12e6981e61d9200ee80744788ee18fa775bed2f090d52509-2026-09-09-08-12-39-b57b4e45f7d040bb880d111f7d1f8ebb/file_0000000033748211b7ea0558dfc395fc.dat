        .matrix-card { background: #1e293b; padding: 30px; border-radius: 16px; width: 350px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3); border: 1px solid #334155; }
        h3 { margin-top: 0; color: #38bdf8; letter-spacing: 1px; }
        .input-box { display: flex; gap: 10px; margin-bottom: 20px; }
        input { flex: 1; padding: 12px; background: #0f172a; border: 1px solid #475569; border-radius: 8px; color: #fff; font-size: 14px; }
        input:focus { outline: none; border-color: #38bdf8; }
        button { padding: 12px; background: #38bdf8; color: #0f172a; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; }
        button:hover { background: #0ea5e9; }
        ul { list-style: none; padding: 0; margin: 0; }
        li { background: #334155; padding: 12px 16px; border-radius: 8px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; font-size: 15px; }
        .clear-matrix { background: transparent; color: #f43f5e; border: 1px solid #f43f5e; width: 100%; margin-top: 15px; }
